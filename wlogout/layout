{
    "label" : "lock",
    "action" : "hyprlock",
    "keybind" : "u"
}

{
    "label" : "logout",
    "action" : "loginctl terminate-user $USER",
    "keybind" : "j"
}

{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "keybind" : "i"
}


{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "keybind" : "k"
}

{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "keybind" : "o"
}

{
    "label" : "hibernate",
    "action" : "hyprlock",
    "keybind" : "l"
}
